{
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "includeFiles": "{../api/scripts/extract-resume-pdf.mjs,../../node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs,../../node_modules/pdfjs-dist/standard_fonts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
