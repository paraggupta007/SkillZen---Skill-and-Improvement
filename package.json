{
  "name": "skillzen",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint apps --ext .ts,.tsx --max-warnings 0",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.6"
  }
}
